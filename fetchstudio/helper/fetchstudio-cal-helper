#!/bin/sh
# fetchstudio-cal-helper - installs the package that provides the `cal` command.
#
# Runs as root through pkexec, gated by the polkit action io.github.bobbycomet.fetchstudio.install-cal.
# It accepts exactly one argument, "install", takes no package names or paths from the caller, ignores the
# caller's environment and only ever runs the distribution's own package manager for one fixed package.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 022

[ "$(id -u)" -eq 0 ] || { echo "fetchstudio-cal-helper: must run as root (use pkexec)" >&2; exit 2; }
[ "$#" -eq 1 ] && [ "$1" = "install" ] || { echo "usage: fetchstudio-cal-helper install" >&2; exit 2; }

if command -v cal >/dev/null 2>&1; then echo "cal is already installed"; exit 0; fi

ids=$(sed -n 's/^\(ID\|ID_LIKE\)=//p' /etc/os-release /usr/lib/os-release 2>/dev/null | tr -d '"' | tr '\n' ' ')
has() { for w in $ids; do [ "$w" = "$1" ] && return 0; done; return 1; }

if has debian || has ubuntu; then
  # Ubuntu, Debian, Linux Mint, Pop!_OS
  export DEBIAN_FRONTEND=noninteractive
  apt-get update
  apt-get install -y ncal
elif has fedora || has rhel || has centos; then
  # Fedora, RHEL, CentOS, AlmaLinux, Rocky Linux
  if command -v dnf >/dev/null 2>&1; then dnf install -y util-linux; else yum install -y util-linux; fi
elif has arch; then
  # Arch Linux, Manjaro, EndeavourOS, CachyOS
  pacman -S --noconfirm --needed util-linux
elif has suse || has opensuse; then
  # openSUSE Tumbleweed and Leap
  zypper --non-interactive install util-linux
else
  echo "Unsupported distribution: install the package that provides 'cal' manually." >&2
  exit 3
fi

command -v cal >/dev/null 2>&1 || { echo "Installation finished but 'cal' is still missing." >&2; exit 4; }
echo "cal installed"
